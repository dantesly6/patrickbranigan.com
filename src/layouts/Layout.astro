---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Patrick Branigan',
  description = 'Designer, maker, gamer. Head of Design at Workweek.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>

    <!-- Boot sequence -->
    <div class="boot-screen" id="boot">
      <div class="boot-panel">
        <div class="boot-header">SYS // BOOTING</div>
        <div class="boot-log" id="boot-log"></div>
        <div class="boot-bar"><span class="boot-bar-fill"></span></div>
      </div>
    </div>

    <!-- Interactive layers -->
    <canvas id="particles"></canvas>
    <div class="spotlight" id="spotlight"></div>
    <div class="cursor" id="cursor"></div>

    <slot />

    <!-- HUD -->
    <div class="hud" aria-hidden="true">
      <span class="hud-dot"></span>
      <span id="hud-phrase" class="hud-prompt"></span>
    </div>

    <!-- Dialogue overlay -->
    <div class="dialogue" id="dialogue">
      <div class="dialogue-inner">
        <p class="dialogue-q" id="dialogue-q"></p>
        <p class="dialogue-a" id="dialogue-a"></p>
        <span class="dialogue-hint mono-xs" id="dialogue-hint">[click to skip]</span>
      </div>
    </div>

    <!-- Project filmstrip overlay -->
    <div class="filmstrip" id="project-overlay">
      <div class="filmstrip-track" id="filmstrip-track">
        <!-- First panel: project text -->
        <div class="filmstrip-panel filmstrip-text">
          <div class="filmstrip-text-inner">
            <p class="dialogue-q" id="project-overlay-title"></p>
            <p class="dialogue-a done" id="project-overlay-desc"></p>
            <div class="overlay-tools" id="project-overlay-tools" aria-label="Tools"></div>
            <span class="dialogue-hint mono-xs">scroll to explore ↓</span>
          </div>
        </div>
        <!-- Image/video panels populated by JS -->
      </div>
      <button class="filmstrip-close" id="filmstrip-close" aria-label="Close">&times;</button>
    </div>

    <!-- Lightbox for tap-to-zoom on filmstrip images -->
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
      <div class="lightbox-content" id="lightbox-content">
        <img id="lightbox-img" src="" alt="" />
      </div>
    </div>

    <script>
      // ============================
      // Boot sequence
      // ============================
      const boot = document.getElementById('boot');
      const bootLog = document.getElementById('boot-log');
      const bootLines: Array<[string, string]> = [
        ['> boot.init()', ''],
        ['> GET /identity.json', '200'],
        ['> GET /projects/*', '200'],
        ['> GET /writing/*', '200'],
        ['> MOUNT /home/patrick', 'OK'],
        ['> READY', ''],
      ];
      let bootT = 120;
      bootLines.forEach(([line, tag], i) => {
        setTimeout(() => {
          if (!bootLog) return;
          const el = document.createElement('div');
          el.className = 'boot-line';
          el.innerHTML = `<span>${line}</span>${tag ? `<span class="boot-tag">${tag}</span>` : ''}`;
          bootLog.appendChild(el);
        }, bootT);
        bootT += i === 0 ? 180 : 240;
      });
      setTimeout(() => boot?.classList.add('done'), 1900);

      // ============================
      // Text scramble effect
      // ============================
      const SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$&';

      function scramble(el: HTMLElement, text: string, staggerMs = 30) {
        const letters = text.split('');
        const current = letters.map(c =>
          c === ' ' ? ' ' : SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)]
        );
        el.textContent = current.join('');

        const intervals: number[] = [];
        letters.forEach((letter, i) => {
          if (letter === ' ') return;
          const flicker = window.setInterval(() => {
            current[i] = SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
            el.textContent = current.join('');
          }, 40);
          intervals.push(flicker);

          setTimeout(() => {
            clearInterval(flicker);
            current[i] = letter;
            el.textContent = current.join('');
          }, i * staggerMs + 200 + Math.random() * 300);
        });
      }

      // Scramble h1 after boot
      const h1Spans = document.querySelectorAll('.scramble-text');
      h1Spans.forEach(span => {
        const text = (span as HTMLElement).dataset.text || '';
        (span as HTMLElement).textContent = text.split('').map(() =>
          SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)]
        ).join('');
      });

      setTimeout(() => {
        h1Spans.forEach(span => {
          const el = span as HTMLElement;
          scramble(el, el.dataset.text || '', 50);
        });
      }, 2000);

      // ============================
      // Custom cursor + spotlight
      // ============================
      const cursor = document.getElementById('cursor');
      const spotlight = document.getElementById('spotlight');
      let mx = 0, my = 0, cx = 0, cy = 0;

      document.addEventListener('mousemove', (e) => {
        mx = e.clientX;
        my = e.clientY;
      });

      function animateCursor() {
        cx += (mx - cx) * 0.15;
        cy += (my - cy) * 0.15;
        if (cursor) {
          cursor.style.left = cx + 'px';
          cursor.style.top = cy + 'px';
        }
        if (spotlight) {
          spotlight.style.left = mx + 'px';
          spotlight.style.top = my + 'px';
        }
        requestAnimationFrame(animateCursor);
      }
      animateCursor();

      // Cursor hover state on interactive elements
      document.querySelectorAll('a, button, .project-card, .game-slot').forEach((el) => {
        el.addEventListener('mouseenter', () => cursor?.classList.add('hovering'));
        el.addEventListener('mouseleave', () => cursor?.classList.remove('hovering'));
      });

      // ============================
      // Magnetic nav links
      // ============================
      const magneticEls = document.querySelectorAll<HTMLElement>('.hero-nav a, .magnetic');
      const MAG_RADIUS = 90;
      const MAG_STRENGTH = 0.4;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const touch = window.matchMedia('(hover: none)').matches;

      if (!reduceMotion && !touch) {
        magneticEls.forEach((el) => {
          el.style.transition = 'transform 260ms cubic-bezier(0.16, 1, 0.3, 1)';
        });
        document.addEventListener('mousemove', (e) => {
          magneticEls.forEach((el) => {
            const r = el.getBoundingClientRect();
            const cxEl = r.left + r.width / 2;
            const cyEl = r.top + r.height / 2;
            const dx = e.clientX - cxEl;
            const dy = e.clientY - cyEl;
            const dist = Math.hypot(dx, dy);
            if (dist < MAG_RADIUS) {
              const f = 1 - dist / MAG_RADIUS;
              el.style.transform = `translate(${dx * MAG_STRENGTH * f}px, ${dy * MAG_STRENGTH * f}px)`;
            } else if (el.style.transform) {
              el.style.transform = '';
            }
          });
        });
      }

      // ============================
      // Particle field
      // ============================
      const canvas = document.getElementById('particles') as HTMLCanvasElement;
      const ctx = canvas?.getContext('2d');

      interface Particle {
        x: number; y: number;
        vx: number; vy: number;
        r: number; a: number;
      }

      let particles: Particle[] = [];
      let W = 0, H = 0;

      function resize() {
        if (!canvas) return;
        W = canvas.width = window.innerWidth;
        H = canvas.height = window.innerHeight;
      }

      function initParticles() {
        const count = Math.floor((W * H) / 14500);
        particles = [];
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * W,
            y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.15,
            vy: (Math.random() - 0.5) * 0.15,
            r: Math.random() * 1.3 + 0.4,
            a: Math.random() * 0.35 + 0.12,
          });
        }
      }

      // Read particle color from CSS var (updates on player switch)
      function getParticleRGB(): string {
        const hex = (window as any).__particleColor || '#4ade80';
        const r = parseInt(hex.slice(1,3), 16);
        const g = parseInt(hex.slice(3,5), 16);
        const b = parseInt(hex.slice(5,7), 16);
        return `${r}, ${g}, ${b}`;
      }

      let prevScrollY = window.scrollY;
      let scrollForce = 0;

      function drawParticles() {
        if (!ctx) return;
        ctx.clearRect(0, 0, W, H);

        // Scroll-reactive force — particles resist your movement
        const currentScrollY = window.scrollY;
        const scrollDelta = currentScrollY - prevScrollY;
        prevScrollY = currentScrollY;
        scrollForce += (scrollDelta - scrollForce) * 0.15;

        // Scroll depth — atmosphere shifts as you move through the page
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const scrollProgress = maxScroll > 0 ? currentScrollY / maxScroll : 0;

        // Ambient wind — direction rotates with scroll depth
        const time = performance.now() * 0.001;
        const windAngle = scrollProgress * Math.PI;
        const windX = Math.sin(time * 0.3) * 0.003 + Math.cos(windAngle) * 0.002;
        const windY = Math.cos(time * 0.2) * 0.002 + Math.sin(windAngle) * 0.002;

        // Particles dim and slow as you go deeper
        const depthDim = 1 - scrollProgress * 0.25;
        const depthDamp = 0.97 + scrollProgress * 0.015;

        const rgb = getParticleRGB();
        for (const p of particles) {
          // Scroll displacement
          p.vy -= scrollForce * 0.02;
          p.vx += (Math.random() - 0.5) * Math.abs(scrollForce) * 0.008;

          // Ambient drift
          p.vx += windX;
          p.vy += windY;

          // Cursor repulsion
          const dx = p.x - mx;
          const dy = p.y - my;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            const force = (120 - dist) / 120 * 0.6;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
          p.vx *= depthDamp;
          p.vy *= depthDamp;
          p.x += p.vx;
          p.y += p.vy;
          // Wrap around
          if (p.x < -10) p.x = W + 10;
          if (p.x > W + 10) p.x = -10;
          if (p.y < -10) p.y = H + 10;
          if (p.y > H + 10) p.y = -10;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${rgb}, ${p.a * depthDim})`;
          ctx.fill();
        }
        requestAnimationFrame(drawParticles);
      }

      if (canvas && ctx) {
        resize();
        initParticles();
        drawParticles();
        window.addEventListener('resize', () => { resize(); initParticles(); });
      }

      // ============================
      // Scroll reveal
      // ============================
      const obs = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('vis');
            if (e.target.classList.contains('section-tag')) {
              const el = e.target as HTMLElement;
              const original = el.textContent || '';
              scramble(el, original, 35);
            }
            obs.unobserve(e.target);
          }
        }),
        { threshold: 0.06, rootMargin: '0px 0px -30px 0px' }
      );
      document.querySelectorAll('.reveal, .stagger').forEach((el) => obs.observe(el));

      // ============================
      // Section tags — scroll-driven drift, bounces back on rest
      // ============================
      if (!reduceMotion) {
        const sectionTags = Array.from(document.querySelectorAll<HTMLElement>('.section-tag'));
        if (sectionTags.length) {
          let lastY = window.scrollY;
          let restTimer: number | undefined;
          const maxOffset = 14;
          const sensitivity = 0.35;
          const onScroll = () => {
            const cur = window.scrollY;
            const dy = cur - lastY;
            lastY = cur;
            const offset = Math.max(-maxOffset, Math.min(maxOffset, -dy * sensitivity));
            sectionTags.forEach((el) => {
              el.style.transition = 'transform 80ms linear';
              el.style.transform = `translateY(${offset}px)`;
            });
            window.clearTimeout(restTimer);
            restTimer = window.setTimeout(() => {
              sectionTags.forEach((el) => {
                el.style.transition = 'transform 700ms cubic-bezier(.34,1.56,.64,1)';
                el.style.transform = 'translateY(0)';
              });
            }, 90);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
        }
      }

      // ============================
      // Library dashboard — replay reveal each time it opens
      // ============================
      const libraryDash = document.querySelector<HTMLDetailsElement>('.library-dashboard');
      if (libraryDash) {
        const ease = 'cubic-bezier(.2,.7,.2,1)';
        const playLibraryReveal = () => {
          const rows = libraryDash.querySelectorAll<HTMLElement>('.library-row');
          const fills = libraryDash.querySelectorAll<HTMLElement>('.library-fill');
          rows.forEach((el, i) => {
            el.getAnimations().forEach((a) => a.cancel());
            el.animate(
              [
                { opacity: 0, transform: 'translateY(10px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              { duration: 520, easing: ease, delay: 60 + i * 80, fill: 'forwards' },
            );
          });
          fills.forEach((el, i) => {
            el.getAnimations().forEach((a) => a.cancel());
            el.animate(
              [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }],
              { duration: 700, easing: ease, delay: 280 + i * 80, fill: 'forwards' },
            );
          });
        };
        libraryDash.addEventListener('toggle', () => {
          if (libraryDash.open) playLibraryReveal();
        });
        if (libraryDash.open) playLibraryReveal();
      }

      // ============================
      // Writing log overlay
      // ============================
      const writingOverlay = document.getElementById('writing-overlay');
      const writingList = document.getElementById('writing-list');
      const writingDetail = document.getElementById('writing-detail');
      const writingDetailDate = document.getElementById('writing-detail-date');
      const writingDetailTitle = document.getElementById('writing-detail-title');
      const writingDetailDesc = document.getElementById('writing-detail-desc');
      const writingBack = document.getElementById('writing-back');
      const writingClose = document.getElementById('writing-overlay-close');
      let writingOpen = false;
      const FADE_MS = 400;

      function showWritingList() {
        writingDetail?.classList.add('fade-out');
        setTimeout(() => {
          writingList?.classList.remove('fade-out');
          writingOverlay!.scrollTop = 0;
        }, FADE_MS);
      }

      function showWritingDetail(date: string, title: string, bodyHTML: string) {
        if (!writingDetailDate || !writingDetailTitle || !writingDetailDesc) return;
        writingList?.classList.add('fade-out');
        setTimeout(() => {
          writingDetailDate.textContent = date;
          writingDetailTitle.textContent = title;
          writingDetailDesc.innerHTML = bodyHTML;
          writingDetail?.classList.remove('fade-out');
          writingOverlay!.scrollTop = 0;
        }, FADE_MS);
      }

      function getWritingBodyHTML(idx: number | string): string {
        const el = document.querySelector(`.writing-list-item[data-writing-idx="${idx}"] .writing-list-body`);
        return el ? el.innerHTML : '';
      }

      document.getElementById('open-writing-log')?.addEventListener('click', () => {
        if (!writingOverlay) return;
        writingList?.classList.remove('fade-out');
        writingDetail?.classList.add('fade-out');
        writingOverlay.scrollTop = 0;
        writingOverlay.classList.add('open');
        writingOpen = true;
      });

      function closeWritingOverlay() {
        writingOverlay?.classList.remove('open');
        writingOpen = false;
      }

      writingClose?.addEventListener('click', closeWritingOverlay);

      document.addEventListener('keydown', (e) => {
        if (writingOpen && e.key === 'Escape') {
          if (!writingDetail?.classList.contains('fade-out')) {
            showWritingList();
          } else {
            closeWritingOverlay();
          }
        }
      });

      document.querySelectorAll('.writing-list-item').forEach((item) => {
        item.addEventListener('click', () => {
          const el = item as HTMLElement;
          const idx = el.dataset.writingIdx || '0';
          showWritingDetail(
            el.dataset.writingDate || '',
            el.dataset.writingTitle || '',
            getWritingBodyHTML(idx)
          );
        });
      });

      writingBack?.addEventListener('click', showWritingList);

      document.querySelectorAll('.writing-readmore').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const el = e.currentTarget as HTMLElement;
          if (!writingOverlay || !writingDetailDate || !writingDetailTitle || !writingDetailDesc) return;
          const idx = el.dataset.writingIdx || '0';
          const sourceItem = document.querySelector(`.writing-list-item[data-writing-idx="${idx}"]`) as HTMLElement | null;
          writingDetailDate.textContent = sourceItem?.dataset.writingDate || '';
          writingDetailTitle.textContent = sourceItem?.dataset.writingTitle || '';
          writingDetailDesc.innerHTML = getWritingBodyHTML(idx);
          writingList?.classList.add('fade-out');
          writingDetail?.classList.remove('fade-out');
          writingOverlay.scrollTop = 0;
          writingOverlay.classList.add('open');
          writingOpen = true;
        });
      });

      // ============================
      // HUD dialogue system — gaming Q&A
      // ============================
      interface QA { q: string; a: string; hint?: boolean; }
      const questions: QA[] = [
        { q: "A game I'd play for the first time again?", a: "The Legend of Zelda: Breath of the Wild." },
        { q: "Most overrated game of all time?", a: "Halo 2. I mean… it was good, don't get me wrong, but…" },
        { q: "A game everyone loved that I couldn't get into?", a: "Elden Ring. Started 8 times. Never got more than 2 hours in." },
        { q: "Best video game soundtrack ever?", a: "Tough one, but I give it to Grand Theft Auto: Vice City." },
        { q: "What dead game deserves a revival?", a: "Cel Damage. Do yourself a favor and play it." },
        { q: "Most emotionally devastating game moment?", a: "The destruction of Kharak in Homeworld. Upon returning from a hyperspace jump, you learn the planet is burning, everyone is dead, and the Taiidan destroyed all orbital facilities. The narrative was delivered impeccably." },
        { q: "Do games need to be fun to be good?", a: "No. It could be terrifying and anxiety-inducing because it's so good. But is that fun?" },
        { q: "A masterpiece most people haven't played?", a: "Far Lone Sails. Absolutely beautiful experience." },
        { q: "Best opening sequence in gaming?", a: "Max Payne. To this day." },
        { q: "Should every game have an easy mode?", a: "No. Every game should have a mode that delivers the experience the developers intended. Doesn't have to be accompanied by something easier." },
        { q: "What beloved game has aged the worst?", a: "GoldenEye 007 on the Nintendo 64, for sure." },
        { q: "Most satisfying gameplay loop ever?", a: "Fuck… this is a hard one to answer." },
        { q: "Are open-world games getting worse?", a: "Tears of the Kingdom is my favorite game of all time at this point, so I have to say no." },
        { q: "Most perfect video game ending?", a: "Silent Hill 2 is pretty damn good…" },
        { q: "My hill to die on in gaming?", a: "Building a game around a single unique or innovative mechanic is still the best way to build a successful game." },
        { q: "A game I keep coming back to?", a: "Lumines. Has to be my favorite puzzle game of all time." },
        { q: "Is nostalgia why people prefer older games?", a: "To some degree. Everyone's definition of \"old\" seems to differ, so…" },
        { q: "A hated game I'll always defend?", a: "DOOM 3. People only hate it because it wasn't a good DOOM game — but it's a damn good survival horror game." },
        { q: "A game for someone who hates games?", a: "Tetris. It's a game for literally anyone and everyone." },
        { q: "Greatest video game villain?", a: "It's Ganondorf for me — but GLaDOS is pretty fucking incredible too." },
        { q: '↑ ↑ ↓ ↓ ← → ← → B A', a: '', hint: true },
      ];

      const pEl = document.getElementById('hud-phrase');
      const dialogueEl = document.getElementById('dialogue');
      const dialogueQ = document.getElementById('dialogue-q');
      const dialogueA = document.getElementById('dialogue-a');
      const dialogueHint = document.getElementById('dialogue-hint');
      let qIndex = 0;
      let dialogueOpen = false;
      let typing = false;
      let typeInterval = 0;
      let fullText = '';

      // Shuffle questions (Fisher-Yates) but keep hint at end
      const hintQ = questions.pop()!;
      for (let i = questions.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [questions[i], questions[j]] = [questions[j], questions[i]];
      }
      // Insert hint at a random spot in the back half
      questions.splice(Math.floor(questions.length * 0.6) + Math.floor(Math.random() * (questions.length * 0.4)), 0, hintQ);

      let promptInterval = 0;

      function showPrompt() {
        if (!pEl || dialogueOpen) return;
        clearInterval(promptInterval);
        const q = questions[qIndex];
        const text = q.hint ? q.q : q.q + ' →';
        pEl.textContent = '';
        let i = 0;
        promptInterval = window.setInterval(() => {
          pEl.textContent += text[i];
          i++;
          if (i >= text.length) clearInterval(promptInterval);
        }, 35);
      }

      // Rotate questions every 8s
      showPrompt();
      setInterval(() => {
        if (!dialogueOpen) {
          qIndex = (qIndex + 1) % questions.length;
          showPrompt();
        }
      }, 8000);

      // Typewriter
      function typewrite(el: HTMLElement, text: string, speed = 25) {
        fullText = text;
        typing = true;
        el.textContent = '';
        el.classList.remove('done');
        let i = 0;
        typeInterval = window.setInterval(() => {
          el.textContent += text[i];
          i++;
          if (i >= text.length) {
            clearInterval(typeInterval);
            typing = false;
            el.classList.add('done');
            if (dialogueHint) dialogueHint.textContent = '[click to close]';
          }
        }, speed);
      }

      function skipType() {
        if (!dialogueA) return;
        clearInterval(typeInterval);
        dialogueA.textContent = fullText;
        dialogueA.classList.add('done');
        typing = false;
        if (dialogueHint) dialogueHint.textContent = '[click to close]';
      }

      function openDialogue() {
        const q = questions[qIndex];
        if (q.hint || !dialogueEl || !dialogueQ || !dialogueA) return;
        dialogueQ.textContent = q.q;
        dialogueA.textContent = '';
        dialogueA.classList.remove('done');
        if (dialogueHint) dialogueHint.textContent = '[click to skip]';
        dialogueEl.classList.add('open');
        dialogueOpen = true;
        setTimeout(() => typewrite(dialogueA, q.a, 25), 500);
      }

      function closeDialogue() {
        if (!dialogueEl) return;
        clearInterval(typeInterval);
        typing = false;
        dialogueEl.classList.remove('open');
        dialogueOpen = false;
        // Advance to next question after closing
        setTimeout(() => {
          qIndex = (qIndex + 1) % questions.length;
          showPrompt();
        }, 800);
      }

      // Click prompt to open, click overlay to skip/close
      pEl?.addEventListener('click', () => {
        if (!dialogueOpen) openDialogue();
      });

      dialogueEl?.addEventListener('click', () => {
        if (typing) skipType();
        else closeDialogue();
      });

      document.addEventListener('keydown', (e) => {
        if (!dialogueOpen) return;
        if (e.key === 'Escape') { closeDialogue(); return; }
        if (typing) skipType();
        else closeDialogue();
      });

      // ============================
      // Project overlay
      // ============================
      const projOverlay = document.getElementById('project-overlay');
      const projTitle = document.getElementById('project-overlay-title');
      const projDesc = document.getElementById('project-overlay-desc');
      const projTools = document.getElementById('project-overlay-tools');
      let projOpen = false;

      const filmstripClose = document.getElementById('filmstrip-close');

      document.querySelectorAll('.project-card').forEach((card) => {
        card.addEventListener('click', () => {
          const el = card as HTMLElement;
          if (!projOverlay || !projTitle || !projDesc) return;
          projDesc.textContent = el.dataset.desc || '';
          projTitle.textContent = el.dataset.project || '';

          // Populate tools list
          if (projTools) {
            const tools: string[] = JSON.parse(el.dataset.tools || '[]');
            projTools.innerHTML = tools.length
              ? tools.map((t) => `<span>${t}</span>`).join('<span class="overlay-tools-sep">·</span>')
              : '';
          }

          // Populate filmstrip image/video panels dynamically
          type MediaItem = string | { src: string | string[]; frame?: 'light' };
          const images: MediaItem[] = JSON.parse(el.dataset.images || '[]');
          const track = document.getElementById('filmstrip-track');

          function createMedia(src: string): HTMLElement {
            const isVideo = /\.(mp4|webm|mov)$/i.test(src);
            if (isVideo) {
              const v = document.createElement('video');
              v.src = src;
              v.autoplay = true;
              v.muted = true;
              v.loop = true;
              v.playsInline = true;
              v.setAttribute('playsinline', '');
              v.setAttribute('preload', 'metadata');
              return v;
            }
            const img = document.createElement('img');
            img.src = src;
            img.loading = 'lazy';
            return img;
          }

          if (track) {
            track.querySelectorAll('.filmstrip-img').forEach((n) => n.remove());
            images.forEach((item) => {
              const srcVal = typeof item === 'string' ? item : item?.src;
              const frame = typeof item === 'string' ? undefined : item?.frame;
              if (!srcVal) return;
              const sources = Array.isArray(srcVal) ? srcVal : [srcVal];
              const panel = document.createElement('div');
              panel.className = 'filmstrip-panel filmstrip-img has-image';
              if (frame === 'light') panel.classList.add('light-frame');
              if (sources.length > 1) panel.classList.add('multi');

              if (frame === 'light') {
                const card = document.createElement('div');
                card.className = 'light-card';
                sources.forEach((s) => card.appendChild(createMedia(s)));
                panel.appendChild(card);
              } else {
                sources.forEach((s) => panel.appendChild(createMedia(s)));
              }
              track.appendChild(panel);
            });
          }

          const jumpToTop = () => {
            const prev = projOverlay.style.scrollBehavior;
            projOverlay.style.scrollBehavior = 'auto';
            projOverlay.scrollTop = 0;
            projOverlay.style.scrollBehavior = prev;
          };
          jumpToTop();

          // Cinematic reveal: card scales out, then overlay opens with staggered children
          el.classList.add('fly-out');
          setTimeout(() => {
            projOverlay.classList.add('open');
            jumpToTop();
            requestAnimationFrame(jumpToTop);
            projOpen = true;
          }, 220);
          setTimeout(() => el.classList.remove('fly-out'), 700);
        });
      });

      function closeProject() {
        projOverlay?.classList.remove('open');
        projOpen = false;
      }

      filmstripClose?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeProject();
      });

      document.addEventListener('keydown', (e) => {
        if (projOpen && e.key === 'Escape') closeProject();
      });

      // ============================
      // Konami code — toggles player 1 / player 2
      // ============================
      const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','KeyB','KeyA'];
      let si = 0;
      let isPlayer2 = false;

      const p1 = { green: '#4ade80', glow: 'rgba(74,222,128,0.2)', dim: 'rgba(74,222,128,0.06)' };
      const p2 = { green: '#e06cc7', glow: 'rgba(224,108,199,0.25)', dim: 'rgba(224,108,199,0.08)' };

      function setPlayerTheme(player2: boolean) {
        const t = player2 ? p2 : p1;
        document.documentElement.style.setProperty('--green', t.green);
        document.documentElement.style.setProperty('--green-glow', t.glow);
        document.documentElement.style.setProperty('--green-dim', t.dim);
        // Update particle color reference
        (window as any).__particleColor = t.green;
      }

      function showToast(msg: string, color: string) {
        const t = document.createElement('div');
        t.textContent = msg;
        t.style.cssText = `position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);font-family:var(--mono);font-size:0.85rem;color:${color};text-shadow:0 0 30px ${color}40;z-index:100001;pointer-events:none;white-space:nowrap;animation:toastKonami 2.5s ease forwards;`;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3000);
      }

      document.addEventListener('keydown', (e) => {
        if (e.code === seq[si]) {
          si++;
          if (si === seq.length) {
            si = 0;
            isPlayer2 = !isPlayer2;
            setPlayerTheme(isPlayer2);
            showToast(
              isPlayer2 ? 'Player 2 has entered the game' : 'Player 1 is back',
              isPlayer2 ? p2.green : p1.green
            );
          }
        } else { si = 0; }
      });

      const ks = document.createElement('style');
      ks.textContent = `@keyframes toastKonami{0%{opacity:0;transform:translate(-50%,-50%) scale(0.9)}15%{opacity:1;transform:translate(-50%,-50%) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(1.03)}}`;
      document.head.appendChild(ks);

      // ============================
      // Newsletter subscribe
      // ============================
      const newsForm = document.getElementById('news-form') as HTMLFormElement | null;
      const newsEmail = document.getElementById('news-email') as HTMLInputElement | null;
      const newsStatus = document.getElementById('news-status');
      const newsBtn = document.getElementById('news-btn') as HTMLButtonElement | null;

      if (newsEmail) {
        const placeholders = [
          'your@email.com',
          'curious@reader.io',
          'monday@inbox.com',
          'patrick@workweek.com',
        ];
        let pIdx = 0;
        const cyclePlaceholder = () => {
          if (document.activeElement === newsEmail || newsEmail.value) return;
          pIdx = (pIdx + 1) % placeholders.length;
          newsEmail.placeholder = placeholders[pIdx];
        };
        setInterval(cyclePlaceholder, 2600);
      }

      newsForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!newsEmail || !newsStatus || !newsBtn) return;
        if (!newsEmail.checkValidity()) {
          newsStatus.textContent = 'That looks off — use a real email.';
          newsStatus.classList.remove('success');
          return;
        }
        const labelEl = newsBtn.querySelector('.news-btn-label');
        const originalLabel = labelEl?.textContent || 'Subscribe';
        newsBtn.disabled = true;
        if (labelEl) labelEl.textContent = 'Subscribing…';
        newsStatus.classList.remove('success');
        newsStatus.textContent = '';
        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: newsEmail.value }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            const msg =
              (data as { error?: string }).error === 'invalid_email'
                ? 'That looks off — use a real email.'
                : 'Couldn’t subscribe just now. Try again in a minute.';
            newsStatus.textContent = msg;
            newsBtn.disabled = false;
            if (labelEl) labelEl.textContent = originalLabel;
            return;
          }
          newsStatus.textContent = `You’re in — a confirmation will land with ${newsEmail.value} soon.`;
          newsStatus.classList.add('success');
          if (labelEl) labelEl.textContent = 'Subscribed';
        } catch {
          newsStatus.textContent = 'Network hiccup. Try again in a minute.';
          newsBtn.disabled = false;
          if (labelEl) labelEl.textContent = originalLabel;
        }
      });

      // ============================
      // Contact button — copy email to clipboard
      // ============================
      const contactBtn = document.getElementById('contact-copy') as HTMLButtonElement | null;
      if (contactBtn) {
        const labelEl = contactBtn.querySelector('.contact-copy-label');
        const originalLabel = labelEl?.textContent || 'Contact';
        let resetTimer: number | undefined;
        contactBtn.addEventListener('click', async () => {
          const email = contactBtn.dataset.email || '';
          if (!email) return;
          try {
            await navigator.clipboard.writeText(email);
          } catch {
            const ta = document.createElement('textarea');
            ta.value = email;
            ta.setAttribute('readonly', '');
            ta.style.position = 'absolute';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch {}
            document.body.removeChild(ta);
          }
          if (labelEl) labelEl.textContent = 'Copied — patrickbranigan@gmail.com';
          contactBtn.classList.add('copied');
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            if (labelEl) labelEl.textContent = originalLabel;
            contactBtn.classList.remove('copied');
          }, 2400);
        });
      }

      // ============================
      // Lightbox — tap-to-zoom on filmstrip images
      // ============================
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxClose = document.getElementById('lightbox-close');
      const lightboxContent = document.getElementById('lightbox-content');

      function openLightbox(src: string, alt: string) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightboxImg.classList.remove('zoomed');
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        if (lightbox) lightbox.scrollTop = 0;
      }
      function closeLightbox() {
        lightbox?.classList.remove('open');
        lightbox?.setAttribute('aria-hidden', 'true');
        if (lightboxImg) {
          lightboxImg.src = '';
          lightboxImg.classList.remove('zoomed');
        }
      }

      projOverlay?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.tagName === 'IMG' && target.closest('.filmstrip-img')) {
          const img = target as HTMLImageElement;
          openLightbox(img.src, img.alt || '');
        }
      });

      lightboxClose?.addEventListener('click', closeLightbox);
      lightboxContent?.addEventListener('click', (e) => {
        if (e.target === lightboxContent) {
          closeLightbox();
        }
      });
      lightboxImg?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!lightboxImg || !lightbox) return;
        const wasZoomed = lightboxImg.classList.toggle('zoomed');
        if (wasZoomed) {
          requestAnimationFrame(() => {
            const targetX = (lightboxImg.offsetWidth - lightbox.clientWidth) / 2;
            const targetY = (lightboxImg.offsetHeight - lightbox.clientHeight) / 2;
            lightbox.scrollTo({ left: Math.max(0, targetX), top: Math.max(0, targetY) });
          });
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox?.classList.contains('open')) {
          closeLightbox();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
