---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Patrick Branigan',
  description = 'Designer, maker, gamer. Head of Design at Workweek.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>

    <!-- Boot sequence -->
    <div class="boot-screen" id="boot">
      <div class="boot-panel">
        <div class="boot-header">SYS // BOOTING</div>
        <div class="boot-log" id="boot-log"></div>
        <div class="boot-bar"><span class="boot-bar-fill"></span></div>
      </div>
    </div>

    <!-- Interactive layers -->
    <canvas id="particles"></canvas>
    <div class="spotlight" id="spotlight"></div>
    <div class="cursor" id="cursor"></div>

    <slot />

    <!-- HUD -->
    <div class="hud" aria-hidden="true">
      <span class="hud-dot"></span>
      <span id="hud-phrase" class="hud-prompt"></span>
    </div>

    <!-- Dialogue overlay -->
    <div class="dialogue" id="dialogue">
      <div class="dialogue-inner">
        <p class="dialogue-q" id="dialogue-q"></p>
        <p class="dialogue-a" id="dialogue-a"></p>
        <span class="dialogue-hint mono-xs" id="dialogue-hint">[click to skip]</span>
      </div>
    </div>

    <!-- Project filmstrip overlay -->
    <div class="filmstrip" id="project-overlay">
      <div class="filmstrip-track" id="filmstrip-track">
        <!-- First panel: project text -->
        <div class="filmstrip-panel filmstrip-text">
          <div class="filmstrip-text-inner">
            <p class="dialogue-q" id="project-overlay-title"></p>
            <p class="dialogue-a done" id="project-overlay-desc"></p>
            <div class="overlay-tools" id="project-overlay-tools" aria-label="Tools"></div>
            <span class="dialogue-hint mono-xs">scroll to explore ↓</span>
          </div>
        </div>
        <!-- Image/video panels populated by JS -->
      </div>
      <button class="filmstrip-close" id="filmstrip-close" aria-label="Close">&times;</button>
    </div>

    <!-- Coin bonus round overlay -->
    <div class="coin-overlay" id="coin-overlay">
      <button class="filmstrip-close" id="coin-overlay-close" aria-label="Close">&times;</button>
      <div class="coin-overlay-inner">
        <div class="coin-state" id="coin-game">
          <div class="coin-game-head">
            <div>
              <p class="section-tag">Bonus Round</p>
              <h2 class="coin-title">Land the coin</h2>
            </div>
            <span class="coin-attempts mono-sm" id="coin-attempts">3 shots</span>
          </div>
          <p class="coin-desc">You're subscribed. Drag the coin back and release to launch. Land it in the slot for a bonus.</p>
          <div class="coin-play" id="coin-play">
            <div class="coin-play-slot" id="coin-play-slot">
              <span class="coin-slot-label mono-xs">SLOT</span>
              <div class="coin-slot-mouth wide"></div>
            </div>
            <svg class="coin-trajectory" id="coin-trajectory" aria-hidden="true"></svg>
            <div class="coin-playable" id="coin-playable">
              <span class="coin-disc large" aria-hidden="true"><span class="coin-disc-face">★</span></span>
            </div>
          </div>
          <p class="coin-status mono-xs" id="coin-game-status">Pull the coin back, release to fire.</p>
        </div>
        <div class="coin-state hidden" id="coin-win">
          <p class="section-tag">Jackpot</p>
          <h2 class="coin-title">Nice shot</h2>
          <p class="coin-desc">A small reward is on its way — details coming soon.</p>
          <p class="coin-status success mono-xs">✓ Subscription locked in · bonus claimed</p>
        </div>
      </div>
    </div>

    <script>
      // ============================
      // Boot sequence
      // ============================
      const boot = document.getElementById('boot');
      const bootLog = document.getElementById('boot-log');
      const bootLines: Array<[string, string]> = [
        ['> boot.init()', ''],
        ['> GET /identity.json', '200'],
        ['> GET /projects/*', '200'],
        ['> GET /writing/*', '200'],
        ['> MOUNT /home/patrick', 'OK'],
        ['> READY', ''],
      ];
      let bootT = 120;
      bootLines.forEach(([line, tag], i) => {
        setTimeout(() => {
          if (!bootLog) return;
          const el = document.createElement('div');
          el.className = 'boot-line';
          el.innerHTML = `<span>${line}</span>${tag ? `<span class="boot-tag">${tag}</span>` : ''}`;
          bootLog.appendChild(el);
        }, bootT);
        bootT += i === 0 ? 180 : 240;
      });
      setTimeout(() => boot?.classList.add('done'), 1900);

      // ============================
      // Text scramble effect
      // ============================
      const SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$&';

      function scramble(el: HTMLElement, text: string, staggerMs = 30) {
        const letters = text.split('');
        const current = letters.map(c =>
          c === ' ' ? ' ' : SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)]
        );
        el.textContent = current.join('');

        const intervals: number[] = [];
        letters.forEach((letter, i) => {
          if (letter === ' ') return;
          const flicker = window.setInterval(() => {
            current[i] = SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
            el.textContent = current.join('');
          }, 40);
          intervals.push(flicker);

          setTimeout(() => {
            clearInterval(flicker);
            current[i] = letter;
            el.textContent = current.join('');
          }, i * staggerMs + 200 + Math.random() * 300);
        });
      }

      // Scramble h1 after boot
      const h1Spans = document.querySelectorAll('.scramble-text');
      h1Spans.forEach(span => {
        const text = (span as HTMLElement).dataset.text || '';
        (span as HTMLElement).textContent = text.split('').map(() =>
          SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)]
        ).join('');
      });

      setTimeout(() => {
        h1Spans.forEach(span => {
          const el = span as HTMLElement;
          scramble(el, el.dataset.text || '', 50);
        });
      }, 2000);

      // ============================
      // Custom cursor + spotlight
      // ============================
      const cursor = document.getElementById('cursor');
      const spotlight = document.getElementById('spotlight');
      let mx = 0, my = 0, cx = 0, cy = 0;

      document.addEventListener('mousemove', (e) => {
        mx = e.clientX;
        my = e.clientY;
      });

      function animateCursor() {
        cx += (mx - cx) * 0.15;
        cy += (my - cy) * 0.15;
        if (cursor) {
          cursor.style.left = cx + 'px';
          cursor.style.top = cy + 'px';
        }
        if (spotlight) {
          spotlight.style.left = mx + 'px';
          spotlight.style.top = my + 'px';
        }
        requestAnimationFrame(animateCursor);
      }
      animateCursor();

      // Cursor hover state on interactive elements
      document.querySelectorAll('a, button, .project-card, .game-slot').forEach((el) => {
        el.addEventListener('mouseenter', () => cursor?.classList.add('hovering'));
        el.addEventListener('mouseleave', () => cursor?.classList.remove('hovering'));
      });

      // ============================
      // Magnetic nav links
      // ============================
      const magneticEls = document.querySelectorAll<HTMLElement>('.hero-nav a, .magnetic');
      const MAG_RADIUS = 90;
      const MAG_STRENGTH = 0.4;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const touch = window.matchMedia('(hover: none)').matches;

      if (!reduceMotion && !touch) {
        magneticEls.forEach((el) => {
          el.style.transition = 'transform 260ms cubic-bezier(0.16, 1, 0.3, 1)';
        });
        document.addEventListener('mousemove', (e) => {
          magneticEls.forEach((el) => {
            const r = el.getBoundingClientRect();
            const cxEl = r.left + r.width / 2;
            const cyEl = r.top + r.height / 2;
            const dx = e.clientX - cxEl;
            const dy = e.clientY - cyEl;
            const dist = Math.hypot(dx, dy);
            if (dist < MAG_RADIUS) {
              const f = 1 - dist / MAG_RADIUS;
              el.style.transform = `translate(${dx * MAG_STRENGTH * f}px, ${dy * MAG_STRENGTH * f}px)`;
            } else if (el.style.transform) {
              el.style.transform = '';
            }
          });
        });
      }

      // ============================
      // Particle field
      // ============================
      const canvas = document.getElementById('particles') as HTMLCanvasElement;
      const ctx = canvas?.getContext('2d');

      interface Particle {
        x: number; y: number;
        vx: number; vy: number;
        r: number; a: number;
      }

      let particles: Particle[] = [];
      let W = 0, H = 0;

      function resize() {
        if (!canvas) return;
        W = canvas.width = window.innerWidth;
        H = canvas.height = window.innerHeight;
      }

      function initParticles() {
        const count = Math.floor((W * H) / 18000);
        particles = [];
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * W,
            y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.15,
            vy: (Math.random() - 0.5) * 0.15,
            r: Math.random() * 1.2 + 0.3,
            a: Math.random() * 0.3 + 0.05,
          });
        }
      }

      // Read particle color from CSS var (updates on player switch)
      function getParticleRGB(): string {
        const hex = (window as any).__particleColor || '#4ade80';
        const r = parseInt(hex.slice(1,3), 16);
        const g = parseInt(hex.slice(3,5), 16);
        const b = parseInt(hex.slice(5,7), 16);
        return `${r}, ${g}, ${b}`;
      }

      let prevScrollY = window.scrollY;
      let scrollForce = 0;

      function drawParticles() {
        if (!ctx) return;
        ctx.clearRect(0, 0, W, H);

        // Scroll-reactive force — particles resist your movement
        const currentScrollY = window.scrollY;
        const scrollDelta = currentScrollY - prevScrollY;
        prevScrollY = currentScrollY;
        scrollForce += (scrollDelta - scrollForce) * 0.15;

        // Scroll depth — atmosphere shifts as you move through the page
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const scrollProgress = maxScroll > 0 ? currentScrollY / maxScroll : 0;

        // Ambient wind — direction rotates with scroll depth
        const time = performance.now() * 0.001;
        const windAngle = scrollProgress * Math.PI;
        const windX = Math.sin(time * 0.3) * 0.003 + Math.cos(windAngle) * 0.002;
        const windY = Math.cos(time * 0.2) * 0.002 + Math.sin(windAngle) * 0.002;

        // Particles dim and slow as you go deeper
        const depthDim = 1 - scrollProgress * 0.25;
        const depthDamp = 0.97 + scrollProgress * 0.015;

        const rgb = getParticleRGB();
        for (const p of particles) {
          // Scroll displacement
          p.vy -= scrollForce * 0.02;
          p.vx += (Math.random() - 0.5) * Math.abs(scrollForce) * 0.008;

          // Ambient drift
          p.vx += windX;
          p.vy += windY;

          // Cursor repulsion
          const dx = p.x - mx;
          const dy = p.y - my;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            const force = (120 - dist) / 120 * 0.6;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
          p.vx *= depthDamp;
          p.vy *= depthDamp;
          p.x += p.vx;
          p.y += p.vy;
          // Wrap around
          if (p.x < -10) p.x = W + 10;
          if (p.x > W + 10) p.x = -10;
          if (p.y < -10) p.y = H + 10;
          if (p.y > H + 10) p.y = -10;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${rgb}, ${p.a * depthDim})`;
          ctx.fill();
        }
        requestAnimationFrame(drawParticles);
      }

      if (canvas && ctx) {
        resize();
        initParticles();
        drawParticles();
        window.addEventListener('resize', () => { resize(); initParticles(); });
      }

      // ============================
      // Scroll reveal
      // ============================
      const obs = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('vis');
            if (e.target.classList.contains('section-tag')) {
              const el = e.target as HTMLElement;
              const original = el.textContent || '';
              scramble(el, original, 35);
            }
            obs.unobserve(e.target);
          }
        }),
        { threshold: 0.06, rootMargin: '0px 0px -30px 0px' }
      );
      document.querySelectorAll('.reveal, .stagger').forEach((el) => obs.observe(el));

      // ============================
      // Writing log overlay
      // ============================
      const writingOverlay = document.getElementById('writing-overlay');
      const writingList = document.getElementById('writing-list');
      const writingDetail = document.getElementById('writing-detail');
      const writingDetailDate = document.getElementById('writing-detail-date');
      const writingDetailTitle = document.getElementById('writing-detail-title');
      const writingDetailDesc = document.getElementById('writing-detail-desc');
      const writingBack = document.getElementById('writing-back');
      const writingClose = document.getElementById('writing-overlay-close');
      let writingOpen = false;
      const FADE_MS = 400;

      function showWritingList() {
        writingDetail?.classList.add('fade-out');
        setTimeout(() => {
          writingList?.classList.remove('fade-out');
          writingOverlay!.scrollTop = 0;
        }, FADE_MS);
      }

      function showWritingDetail(date: string, title: string, desc: string) {
        if (!writingDetailDate || !writingDetailTitle || !writingDetailDesc) return;
        writingList?.classList.add('fade-out');
        setTimeout(() => {
          writingDetailDate.textContent = date;
          writingDetailTitle.textContent = title;
          writingDetailDesc.textContent = desc;
          writingDetail?.classList.remove('fade-out');
          writingOverlay!.scrollTop = 0;
        }, FADE_MS);
      }

      document.getElementById('open-writing-log')?.addEventListener('click', () => {
        if (!writingOverlay) return;
        writingList?.classList.remove('fade-out');
        writingDetail?.classList.add('fade-out');
        writingOverlay.scrollTop = 0;
        writingOverlay.classList.add('open');
        writingOpen = true;
      });

      function closeWritingOverlay() {
        writingOverlay?.classList.remove('open');
        writingOpen = false;
      }

      writingClose?.addEventListener('click', closeWritingOverlay);

      document.addEventListener('keydown', (e) => {
        if (writingOpen && e.key === 'Escape') {
          if (!writingDetail?.classList.contains('fade-out')) {
            showWritingList();
          } else {
            closeWritingOverlay();
          }
        }
      });

      document.querySelectorAll('.writing-list-item').forEach((item) => {
        item.addEventListener('click', () => {
          const el = item as HTMLElement;
          showWritingDetail(
            el.dataset.writingDate || '',
            el.dataset.writingTitle || '',
            el.dataset.writingDesc || ''
          );
        });
      });

      writingBack?.addEventListener('click', showWritingList);

      // ============================
      // HUD dialogue system — gaming Q&A
      // ============================
      interface QA { q: string; a: string; hint?: boolean; }
      const questions: QA[] = [
        { q: 'A game I\'d play for the first time again?', a: '[Answer coming soon]' },
        { q: 'Most overrated game of all time?', a: '[Answer coming soon]' },
        { q: 'A game everyone loved that I couldn\'t get into?', a: '[Answer coming soon]' },
        { q: 'Best video game soundtrack ever?', a: '[Answer coming soon]' },
        { q: 'What dead game deserves a revival?', a: '[Answer coming soon]' },
        { q: 'Most emotionally devastating game moment?', a: '[Answer coming soon]' },
        { q: 'Do games need to be fun to be good?', a: '[Answer coming soon]' },
        { q: 'A masterpiece most people haven\'t played?', a: '[Answer coming soon]' },
        { q: 'Best opening sequence in gaming?', a: '[Answer coming soon]' },
        { q: 'Should every game have an easy mode?', a: '[Answer coming soon]' },
        { q: 'What beloved game has aged the worst?', a: '[Answer coming soon]' },
        { q: 'Most satisfying gameplay loop ever?', a: '[Answer coming soon]' },
        { q: 'Are open-world games getting worse?', a: '[Answer coming soon]' },
        { q: 'Most perfect video game ending?', a: '[Answer coming soon]' },
        { q: 'My hill to die on in gaming?', a: '[Answer coming soon]' },
        { q: 'A game I keep coming back to?', a: '[Answer coming soon]' },
        { q: 'Is nostalgia why people prefer older games?', a: '[Answer coming soon]' },
        { q: 'A hated game I\'ll always defend?', a: '[Answer coming soon]' },
        { q: 'A game for someone who hates games?', a: '[Answer coming soon]' },
        { q: 'Greatest video game villain?', a: '[Answer coming soon]' },
        { q: '↑ ↑ ↓ ↓ ← → ← → B A', a: '', hint: true },
      ];

      const pEl = document.getElementById('hud-phrase');
      const dialogueEl = document.getElementById('dialogue');
      const dialogueQ = document.getElementById('dialogue-q');
      const dialogueA = document.getElementById('dialogue-a');
      const dialogueHint = document.getElementById('dialogue-hint');
      let qIndex = 0;
      let dialogueOpen = false;
      let typing = false;
      let typeInterval = 0;
      let fullText = '';

      // Shuffle questions (Fisher-Yates) but keep hint at end
      const hintQ = questions.pop()!;
      for (let i = questions.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [questions[i], questions[j]] = [questions[j], questions[i]];
      }
      // Insert hint at a random spot in the back half
      questions.splice(Math.floor(questions.length * 0.6) + Math.floor(Math.random() * (questions.length * 0.4)), 0, hintQ);

      let promptInterval = 0;

      function showPrompt() {
        if (!pEl || dialogueOpen) return;
        clearInterval(promptInterval);
        const q = questions[qIndex];
        const text = q.hint ? q.q : q.q + ' →';
        pEl.textContent = '';
        let i = 0;
        promptInterval = window.setInterval(() => {
          pEl.textContent += text[i];
          i++;
          if (i >= text.length) clearInterval(promptInterval);
        }, 35);
      }

      // Rotate questions every 8s
      showPrompt();
      setInterval(() => {
        if (!dialogueOpen) {
          qIndex = (qIndex + 1) % questions.length;
          showPrompt();
        }
      }, 8000);

      // Typewriter
      function typewrite(el: HTMLElement, text: string, speed = 25) {
        fullText = text;
        typing = true;
        el.textContent = '';
        el.classList.remove('done');
        let i = 0;
        typeInterval = window.setInterval(() => {
          el.textContent += text[i];
          i++;
          if (i >= text.length) {
            clearInterval(typeInterval);
            typing = false;
            el.classList.add('done');
            if (dialogueHint) dialogueHint.textContent = '[click to close]';
          }
        }, speed);
      }

      function skipType() {
        if (!dialogueA) return;
        clearInterval(typeInterval);
        dialogueA.textContent = fullText;
        dialogueA.classList.add('done');
        typing = false;
        if (dialogueHint) dialogueHint.textContent = '[click to close]';
      }

      function openDialogue() {
        const q = questions[qIndex];
        if (q.hint || !dialogueEl || !dialogueQ || !dialogueA) return;
        dialogueQ.textContent = q.q;
        dialogueA.textContent = '';
        dialogueA.classList.remove('done');
        if (dialogueHint) dialogueHint.textContent = '[click to skip]';
        dialogueEl.classList.add('open');
        dialogueOpen = true;
        setTimeout(() => typewrite(dialogueA, q.a, 25), 500);
      }

      function closeDialogue() {
        if (!dialogueEl) return;
        clearInterval(typeInterval);
        typing = false;
        dialogueEl.classList.remove('open');
        dialogueOpen = false;
        // Advance to next question after closing
        setTimeout(() => {
          qIndex = (qIndex + 1) % questions.length;
          showPrompt();
        }, 800);
      }

      // Click prompt to open, click overlay to skip/close
      pEl?.addEventListener('click', () => {
        if (!dialogueOpen) openDialogue();
      });

      dialogueEl?.addEventListener('click', () => {
        if (typing) skipType();
        else closeDialogue();
      });

      document.addEventListener('keydown', (e) => {
        if (!dialogueOpen) return;
        if (e.key === 'Escape') { closeDialogue(); return; }
        if (typing) skipType();
        else closeDialogue();
      });

      // ============================
      // Project overlay
      // ============================
      const projOverlay = document.getElementById('project-overlay');
      const projTitle = document.getElementById('project-overlay-title');
      const projDesc = document.getElementById('project-overlay-desc');
      const projTools = document.getElementById('project-overlay-tools');
      let projOpen = false;

      const filmstripClose = document.getElementById('filmstrip-close');

      document.querySelectorAll('.project-card').forEach((card) => {
        card.addEventListener('click', () => {
          const el = card as HTMLElement;
          if (!projOverlay || !projTitle || !projDesc) return;
          projDesc.textContent = el.dataset.desc || '';
          projTitle.textContent = el.dataset.project || '';

          // Populate tools list
          if (projTools) {
            const tools: string[] = JSON.parse(el.dataset.tools || '[]');
            projTools.innerHTML = tools.length
              ? tools.map((t) => `<span>${t}</span>`).join('<span class="overlay-tools-sep">·</span>')
              : '';
          }

          // Populate filmstrip image/video panels dynamically
          type MediaItem = string | { src: string | string[]; frame?: 'light' };
          const images: MediaItem[] = JSON.parse(el.dataset.images || '[]');
          const track = document.getElementById('filmstrip-track');

          function createMedia(src: string): HTMLElement {
            const isVideo = /\.(mp4|webm|mov)$/i.test(src);
            if (isVideo) {
              const v = document.createElement('video');
              v.src = src;
              v.autoplay = true;
              v.muted = true;
              v.loop = true;
              v.playsInline = true;
              v.setAttribute('playsinline', '');
              v.setAttribute('preload', 'metadata');
              return v;
            }
            const img = document.createElement('img');
            img.src = src;
            img.loading = 'lazy';
            return img;
          }

          if (track) {
            track.querySelectorAll('.filmstrip-img').forEach((n) => n.remove());
            images.forEach((item) => {
              const srcVal = typeof item === 'string' ? item : item?.src;
              const frame = typeof item === 'string' ? undefined : item?.frame;
              if (!srcVal) return;
              const sources = Array.isArray(srcVal) ? srcVal : [srcVal];
              const panel = document.createElement('div');
              panel.className = 'filmstrip-panel filmstrip-img has-image';
              if (frame === 'light') panel.classList.add('light-frame');
              if (sources.length > 1) panel.classList.add('multi');

              if (frame === 'light') {
                const card = document.createElement('div');
                card.className = 'light-card';
                sources.forEach((s) => card.appendChild(createMedia(s)));
                panel.appendChild(card);
              } else if (sources.length === 1 && !/\.(mp4|webm|mov)$/i.test(sources[0])) {
                // Single image: keep background-image for crispness
                panel.style.backgroundImage = `url(${sources[0]})`;
                panel.style.backgroundSize = 'contain';
                panel.style.backgroundPosition = 'center';
                panel.style.backgroundRepeat = 'no-repeat';
              } else {
                sources.forEach((s) => panel.appendChild(createMedia(s)));
              }
              track.appendChild(panel);
            });
          }

          projOverlay.scrollTop = 0;
          projOverlay.classList.add('open');
          projOpen = true;
        });
      });

      function closeProject() {
        projOverlay?.classList.remove('open');
        projOpen = false;
      }

      // Drag-to-scroll on filmstrip (vertical)
      if (projOverlay) {
        let isDragging = false;
        let dragStartY = 0;
        let dragScrollStart = 0;
        let hasDragged = false;
        let lastY = 0;
        let velocity = 0;

        // Panel snap positions: first panel is shorter (100vh - 80px), rest are 100vh
        function nearestPanel(scrollPos: number): number {
          const vh = window.innerHeight;
          const firstH = vh - 80;
          if (scrollPos < firstH / 2) return 0;
          const pastFirst = scrollPos - firstH;
          const idx = Math.round(pastFirst / vh);
          return firstH + Math.max(0, idx) * vh;
        }

        projOverlay.addEventListener('mousedown', (e: MouseEvent) => {
          if ((e.target as HTMLElement).closest('.filmstrip-close')) return;
          isDragging = true;
          hasDragged = false;
          dragStartY = e.pageY;
          lastY = e.pageY;
          velocity = 0;
          dragScrollStart = projOverlay.scrollTop;
          projOverlay.classList.add('grabbing');
        });

        window.addEventListener('mousemove', (e: MouseEvent) => {
          if (!isDragging) return;
          const dy = e.pageY - dragStartY;
          velocity = lastY - e.pageY;
          lastY = e.pageY;
          if (Math.abs(dy) > 5) hasDragged = true;
          projOverlay.scrollTop = dragScrollStart - dy;
        });

        window.addEventListener('mouseup', () => {
          if (!isDragging) return;
          isDragging = false;
          projOverlay.classList.remove('grabbing');
          // Smooth scroll to nearest panel, factoring in momentum
          const projected = projOverlay.scrollTop + velocity * 8;
          const target = nearestPanel(projected);
          projOverlay.scrollTo({ top: target, behavior: 'smooth' });
        });

        // Prevent click-to-close when user was dragging
        projOverlay.addEventListener('click', (e: MouseEvent) => {
          if (hasDragged) {
            e.stopPropagation();
            hasDragged = false;
          }
        }, true);
      }

      filmstripClose?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeProject();
      });

      document.addEventListener('keydown', (e) => {
        if (projOpen && e.key === 'Escape') closeProject();
      });

      // ============================
      // Konami code — toggles player 1 / player 2
      // ============================
      const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','KeyB','KeyA'];
      let si = 0;
      let isPlayer2 = false;

      const p1 = { green: '#4ade80', glow: 'rgba(74,222,128,0.2)', dim: 'rgba(74,222,128,0.06)' };
      const p2 = { green: '#e06cc7', glow: 'rgba(224,108,199,0.25)', dim: 'rgba(224,108,199,0.08)' };

      function setPlayerTheme(player2: boolean) {
        const t = player2 ? p2 : p1;
        document.documentElement.style.setProperty('--green', t.green);
        document.documentElement.style.setProperty('--green-glow', t.glow);
        document.documentElement.style.setProperty('--green-dim', t.dim);
        // Update particle color reference
        (window as any).__particleColor = t.green;
      }

      function showToast(msg: string, color: string) {
        const t = document.createElement('div');
        t.textContent = msg;
        t.style.cssText = `position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);font-family:var(--mono);font-size:0.85rem;color:${color};text-shadow:0 0 30px ${color}40;z-index:100001;pointer-events:none;white-space:nowrap;animation:toastKonami 2.5s ease forwards;`;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3000);
      }

      document.addEventListener('keydown', (e) => {
        if (e.code === seq[si]) {
          si++;
          if (si === seq.length) {
            si = 0;
            isPlayer2 = !isPlayer2;
            setPlayerTheme(isPlayer2);
            showToast(
              isPlayer2 ? 'Player 2 has entered the game' : 'Player 1 is back',
              isPlayer2 ? p2.green : p1.green
            );
          }
        } else { si = 0; }
      });

      const ks = document.createElement('style');
      ks.textContent = `@keyframes toastKonami{0%{opacity:0;transform:translate(-50%,-50%) scale(0.9)}15%{opacity:1;transform:translate(-50%,-50%) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(1.03)}}`;
      document.head.appendChild(ks);

      // ============================
      // Coin subscribe (newsletter) — game flow
      // ============================
      const coinForm = document.getElementById('coin-form') as HTMLFormElement | null;
      const coinEmail = document.getElementById('coin-email') as HTMLInputElement | null;
      const coinStatus = document.getElementById('coin-status');
      const coinIntro = document.getElementById('coin-intro');
      const coinGame = document.getElementById('coin-game');
      const coinWin = document.getElementById('coin-win');
      const coinPlay = document.getElementById('coin-play');
      const coinPlayable = document.getElementById('coin-playable');
      const coinPlaySlot = document.getElementById('coin-play-slot');
      const coinTraj = document.getElementById('coin-trajectory') as unknown as SVGSVGElement | null;
      const coinAttemptsEl = document.getElementById('coin-attempts');
      const coinGameStatus = document.getElementById('coin-game-status');

      const coinOverlay = document.getElementById('coin-overlay');
      const coinOverlayClose = document.getElementById('coin-overlay-close');
      let coinGameInited = false;

      function openCoinOverlay() {
        if (!coinOverlay) return;
        coinOverlay.classList.add('open');
        document.body.style.overflow = 'hidden';
        if (!coinGameInited) {
          setTimeout(() => {
            initCoinGame();
            coinGameInited = true;
          }, 80);
        }
      }

      function closeCoinOverlay() {
        if (!coinOverlay) return;
        coinOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }

      coinForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!coinEmail || !coinStatus) return;
        if (!coinEmail.checkValidity()) {
          coinStatus.textContent = 'That looks off — use a real email.';
          coinStatus.classList.remove('success');
          return;
        }
        coinStatus.textContent = `Subscribed. ${coinEmail.value} is in.`;
        coinStatus.classList.add('success');
        openCoinOverlay();
      });

      coinOverlayClose?.addEventListener('click', closeCoinOverlay);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && coinOverlay?.classList.contains('open')) closeCoinOverlay();
      });

      // Coin launcher physics
      function initCoinGame() {
        if (!coinPlay || !coinPlayable || !coinPlaySlot || !coinTraj || !coinAttemptsEl || !coinGameStatus) return;

        const GRAVITY = 0.42;
        const POWER = 0.28;
        const MAX_PULL = 110;
        const WIN_FLOAT_MS = 260; // slot catch window flash
        let attempts = 3;
        let animId = 0;
        let dragging = false;
        let flying = false;
        let gameOver = false;
        let sx = 0, sy = 0; // drag start
        let dx = 0, dy = 0; // drag delta (pull)
        let px = 0, py = 0; // coin position (relative to play area)
        let vx = 0, vy = 0;

        const playRect = () => coinPlay.getBoundingClientRect();
        const slotMouth = coinPlaySlot.querySelector('.coin-slot-mouth') as HTMLElement;

        function resetCoin() {
          if (!coinPlayable || !coinPlay) return;
          dragging = false;
          flying = false;
          dx = 0; dy = 0; vx = 0; vy = 0;
          coinPlayable.style.transform = '';
          coinPlayable.classList.remove('flying');
          drawTrajectory(0, 0);
        }

        function updateAttempts() {
          if (!coinAttemptsEl) return;
          coinAttemptsEl.textContent = `${attempts} shot${attempts === 1 ? '' : 's'}`;
        }

        function drawTrajectory(pdx: number, pdy: number) {
          if (!coinTraj || !coinPlayable) return;
          while (coinTraj.firstChild) coinTraj.removeChild(coinTraj.firstChild);
          if (!pdx && !pdy) return;
          const rect = playRect();
          const coinRect = coinPlayable.getBoundingClientRect();
          const originX = (coinRect.left + coinRect.width / 2) - rect.left;
          const originY = (coinRect.top + coinRect.height / 2) - rect.top;
          const svgNS = 'http://www.w3.org/2000/svg';
          let tvx = -pdx * POWER;
          let tvy = -pdy * POWER;
          let tx = originX, ty = originY;
          let prevX = tx, prevY = ty;
          for (let step = 0; step < 30; step++) {
            tvy += GRAVITY;
            tx += tvx;
            ty += tvy;
            if (tx < -10 || tx > rect.width + 10 || ty > rect.height + 20) break;
            const dot = document.createElementNS(svgNS, 'circle');
            dot.setAttribute('cx', `${tx}`);
            dot.setAttribute('cy', `${ty}`);
            dot.setAttribute('r', '1.6');
            dot.setAttribute('opacity', `${Math.max(0, 1 - step / 30)}`);
            coinTraj.appendChild(dot);
            prevX = tx; prevY = ty;
          }
        }

        function hitSlot(): boolean {
          if (!coinPlayable || !coinPlay) return false;
          const coinRect = coinPlayable.getBoundingClientRect();
          const mouth = slotMouth.getBoundingClientRect();
          const cx = coinRect.left + coinRect.width / 2;
          const cy = coinRect.top + coinRect.height / 2;
          // Catch zone: slot mouth expanded vertically
          return cx >= mouth.left && cx <= mouth.right && cy >= mouth.top - 18 && cy <= mouth.bottom + 10;
        }

        function startFlight() {
          if (!coinPlayable || !coinPlay) return;
          flying = true;
          vx = -dx * POWER;
          vy = -dy * POWER;
          // Capture starting offset so transforms remain relative
          px = 0; py = 0;
          drawTrajectory(0, 0);
          coinPlayable.classList.add('flying');
          animId = requestAnimationFrame(tick);
        }

        function tick() {
          if (!coinPlayable || !coinPlay) return;
          vy += GRAVITY;
          px += vx;
          py += vy;
          coinPlayable.style.transform = `translate(${px}px, ${py}px) rotate(${px * 6}deg)`;

          if (hitSlot()) {
            cancelAnimationFrame(animId);
            coinPlaySlot.classList.add('catch');
            setTimeout(() => coinPlaySlot.classList.remove('catch'), WIN_FLOAT_MS);
            setTimeout(() => onWin(), 280);
            return;
          }

          const rect = playRect();
          const coinRect = coinPlayable.getBoundingClientRect();
          const relX = (coinRect.left + coinRect.width / 2) - rect.left;
          const relY = (coinRect.top + coinRect.height / 2) - rect.top;
          if (relX < -40 || relX > rect.width + 40 || relY > rect.height + 40) {
            cancelAnimationFrame(animId);
            attempts--;
            updateAttempts();
            if (attempts <= 0) {
              gameOver = true;
              if (coinGameStatus) {
                coinGameStatus.textContent = 'Out of coins. You\'re still subscribed — that\'s the real prize.';
                coinGameStatus.classList.add('success');
              }
              return;
            }
            if (coinGameStatus) coinGameStatus.textContent = 'Missed. Try again.';
            resetCoin();
            return;
          }
          animId = requestAnimationFrame(tick);
        }

        function onWin() {
          if (!coinGame || !coinWin) return;
          coinGame.classList.add('hidden');
          coinWin.classList.remove('hidden');
        }

        function pointerDown(e: PointerEvent) {
          if (flying || gameOver) return;
          dragging = true;
          coinPlayable!.classList.add('grabbing');
          sx = e.clientX; sy = e.clientY;
          dx = 0; dy = 0;
          coinPlayable!.setPointerCapture(e.pointerId);
        }
        function pointerMove(e: PointerEvent) {
          if (!dragging) return;
          let ddx = e.clientX - sx;
          let ddy = e.clientY - sy;
          const mag = Math.hypot(ddx, ddy);
          if (mag > MAX_PULL) {
            const k = MAX_PULL / mag;
            ddx *= k; ddy *= k;
          }
          dx = ddx; dy = ddy;
          coinPlayable!.style.transform = `translate(${dx}px, ${dy}px)`;
          drawTrajectory(dx, dy);
        }
        function pointerUp() {
          if (!dragging) return;
          dragging = false;
          coinPlayable!.classList.remove('grabbing');
          if (Math.hypot(dx, dy) < 8) {
            // Too small a pull — cancel, reset
            resetCoin();
            return;
          }
          if (coinGameStatus && !coinGameStatus.classList.contains('success')) {
            coinGameStatus.textContent = '...';
          }
          startFlight();
        }

        coinPlayable.addEventListener('pointerdown', pointerDown);
        coinPlayable.addEventListener('pointermove', pointerMove);
        coinPlayable.addEventListener('pointerup', pointerUp);
        coinPlayable.addEventListener('pointercancel', pointerUp);

        updateAttempts();
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
