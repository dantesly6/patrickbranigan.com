---
// A writing entry's own address: the same site, opened on Thinking with this entry's reading sheet up.
import { page, writing, writingLinks } from '../../lib/site';
export async function getStaticPaths() { return (await writing()).map(it => ({ params: { slug: it.slug } })); }
const items = await writing();
const it = items.find(x => x.slug === Astro.params.slug)!;
const body = it.entry.rendered?.html ?? (it.entry.body ?? '').split(/\n\s*\n/).map(p => `<p>${p}</p>`).join('');
const html = page({ path: `/log/${it.slug}/`, title: it.title, description: it.excerpt || 'A log entry by Patrick Branigan.', type: 'article', open: it.slug, items,
  noscript: `<p><a href="/">Patrick Branigan</a></p><article><h1>${it.title.replace(/</g, '&lt;')}</h1><p>${it.date}</p>${body}</article>${writingLinks(items)}` });
---
<Fragment set:html={html} />
