// The homepage is the redesign itself, src/site/signal.html, filled in by src/lib/site.ts.
import { page, writing, writingLinks, DESCRIPTION } from '../lib/site';
const items = await writing();
const html = page({ path: '/', title: 'Patrick Branigan', description: DESCRIPTION, items,
  noscript: `<h1>Patrick Branigan</h1><p>${DESCRIPTION}</p><p>This site is interactive and needs JavaScript. The writing reads fine without it:</p>${writingLinks(items)}` });
---
<Fragment set:html={html} />
