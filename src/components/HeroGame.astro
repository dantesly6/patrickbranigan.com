---
// Hero game intro: a one-input Flappy-grade game that lives over the hero on first load.
// On death, the dot expands to flood the screen with --green, hero text fades in,
// then the green wipes to --bg and the overlay fades to 0 — revealing the real DOM hero
// underneath at the exact same position. Score persists in #flight-badge.
---

<div id="hero-game-overlay">
  <canvas id="hero-game-canvas"></canvas>
</div>
<div id="flight-badge" aria-hidden="true"></div>

<style is:global>
  /* Lock the page while the game is active */
  html.hero-game-active,
  html.hero-game-active body { overflow: hidden; }

  /* Boot screen runs first (its own ~1.9s sequence), then fades via its
     own .done class — naturally revealing the canvas overlay underneath
     since both share var(--bg). No special hide rule needed. */

  /* HUD sits above the overlay (z 10000 > 8000), hide it during the game.
     Particles (z 0) and spotlight (z -1) sit below the overlay, so the
     overlay's own fade naturally reveals them — no separate rule needed. */
  html.hero-game-active .hud {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  #hero-game-overlay {
    position: fixed; inset: 0;
    z-index: 8000;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease;
  }
  html.hero-game-active #hero-game-overlay {
    opacity: 1;
    pointer-events: auto;
  }
  #hero-game-overlay.dismiss {
    opacity: 0;
    pointer-events: none;
  }
  #hero-game-canvas {
    display: block;
    width: 100vw; height: 100vh;
    cursor: pointer;
    touch-action: manipulation;
  }

  #flight-badge {
    position: fixed;
    top: 24px; right: 28px;
    z-index: 100;
    color: var(--text-mid);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms ease 250ms;
  }
  body.flight-shown #flight-badge { opacity: 1; }
</style>

<script>
  (() => {
    const html = document.documentElement;
    if (!html.classList.contains('hero-game-active')) return;

    const canvas = document.getElementById('hero-game-canvas') as HTMLCanvasElement | null;
    const overlay = document.getElementById('hero-game-overlay');
    const badge = document.getElementById('flight-badge');
    if (!canvas || !overlay) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) { html.classList.remove('hero-game-active'); return; }

    const C = {
      bg:        '#1a1713',
      boundary:  '#2d2821',
      obstacle:  '#5a5650',
      text:      '#ece8e1',
      textDim:   '#5a5650',
      textMid:   '#a09a90',
      green:     '#4ade80',
      greenGlow: 'rgba(74, 222, 128, 0.35)',
    };

    const PHYS = {
      gravity: 1500,
      impulse: -450,
      baseScroll: 200,
      spacing: 280,
      baseGap: 180,
      margin: 90,
      birdR: 9,
      obstacleStroke: 1.5,
      boundaryStroke: 1,
    };

    function currentScroll() { return PHYS.baseScroll + Math.min(game.score * 4, 130); }
    function currentGap()    { return Math.max(132, PHYS.baseGap - Math.max(0, game.score - 4) * 2.4); }

    // Reward tiers, in seconds survived — TUNE BY FEEL.
    // (Low for the prototype so tiers are reachable while testing.)
    const TIER = { t1: 12, t2: 30 };
    function tierFor(s: number) { return s >= TIER.t2 ? 2 : s >= TIER.t1 ? 1 : 0; }
    const DEV_SHORTCUTS = true; // press 0/1/2 on the idle screen to simulate a tier death

    let W = 0, H = 0, dpr = 1;
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas!.width  = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      canvas!.style.width  = W + 'px';
      canvas!.style.height = H + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    type Obstacle = { worldX: number; gapY: number; gapSize: number; passed: boolean; };
    type RankData = { rank: number; total: number; seconds: number };
    const game = {
      state: 'idle' as 'idle' | 'playing' | 'dying' | 'done',
      bird: { y: 0, vy: 0 },
      worldOffset: 0,
      obstacles: [] as Obstacle[],
      score: 0,
      startTime: 0,
      duration: 0,
      deathTime: 0,
      deathX: 0, deathY: 0,
      audioCtx: null as AudioContext | null,
      handoffStarted: false,
      rankData: null as RankData | null,
    };

    const PH = {
      hold:      { s: 0,    e: 110  },
      expand:    { s: 110,  e: 760  },
      greenHold: { s: 760,  e: 900  },
      textIn:    { s: 900,  e: 1200 },
      textHold:  { s: 1200, e: 1650 },
      wipe:      { s: 1650, e: 2100 },
      done:      { s: 2100, e: 2100 },
    };
    function phaseT(name: keyof typeof PH, t: number) {
      const p = PH[name];
      if (t < p.s) return 0;
      if (t >= p.e) return 1;
      return (t - p.s) / (p.e - p.s);
    }
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    const easeInOut = (t: number) => t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;

    function ensureAudio() {
      if (game.audioCtx) return;
      try { game.audioCtx = new ((window as any).AudioContext || (window as any).webkitAudioContext)(); } catch (e) {}
    }
    function playNote(freq: number, dur = 0.18, vol = 0.07) {
      if (!game.audioCtx) return;
      const ac = game.audioCtx;
      const t = ac.currentTime;
      const osc = ac.createOscillator();
      const gain = ac.createGain();
      osc.type = 'sine';
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(vol, t + 0.008);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(gain).connect(ac.destination);
      osc.start(t);
      osc.stop(t + dur + 0.05);
    }
    const PENTATONIC = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25, 587.33];

    function makeObstacle(worldX: number): Obstacle {
      const gapSize = currentGap();
      const minY = PHYS.margin;
      const maxY = H - PHYS.margin - gapSize;
      return { worldX, gapY: minY + Math.random() * Math.max(maxY - minY, 0), gapSize, passed: false };
    }

    function reset() {
      game.state = 'idle';
      game.bird = { y: H / 2, vy: 0 };
      game.worldOffset = 0;
      game.obstacles = [];
      game.score = 0;
      game.startTime = 0;
      game.duration = 0;
      game.deathTime = 0;
      game.handoffStarted = false;
      game.rankData = null;
      let x = W * 0.7;
      while (x < W * 2.4) { game.obstacles.push(makeObstacle(x)); x += PHYS.spacing; }
    }

    function birdScreenX() { return W * 0.30; }
    function birdWorldX()  { return birdScreenX() + game.worldOffset; }

    function flap() {
      if (game.state !== 'playing') return;
      game.bird.vy = PHYS.impulse;
      ensureAudio();
      const yRatio = 1 - Math.max(0, Math.min(1, game.bird.y / H));
      const idx = Math.min(PENTATONIC.length - 1, Math.floor(yRatio * PENTATONIC.length));
      playNote(PENTATONIC[idx]);
    }

    function startGame() {
      game.state = 'playing';
      game.startTime = performance.now();
    }

    function submitFlight(seconds: number) {
      fetch('/api/flight', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seconds }),
      })
        .then(r => r.ok ? r.json() : null)
        .then((data: RankData | null) => {
          if (data && Number.isFinite(data.rank) && Number.isFinite(data.total)) {
            game.rankData = data;
            // If the badge has already been populated (handoff already ran), refresh it now.
            if (badge && badge.textContent) updateBadge();
          }
        })
        .catch(() => { /* api unavailable — fallback (TIME X.Xs) was already shown */ });
    }

    function updateBadge() {
      if (!badge) return;
      const rd = game.rankData;
      if (rd && rd.rank > 0 && rd.total > 0) {
        badge.textContent = `RANK ${rd.rank.toLocaleString()} / ${rd.total.toLocaleString()}`;
      } else if (game.duration > 0) {
        badge.textContent = `TIME ${game.duration.toFixed(1)}s`;
      }
    }

    function onTap() {
      ensureAudio();
      if (game.audioCtx && game.audioCtx.state === 'suspended') game.audioCtx.resume();
      if (game.state === 'idle') { startGame(); flap(); }
      else if (game.state === 'playing') { flap(); }
    }

    function die() {
      game.state = 'dying';
      game.deathTime = performance.now();
      game.deathX = birdScreenX();
      game.deathY = game.bird.y;
      // Lock duration and fire the rank request immediately — the response
      // should be back by the time the badge fades in (~1.3s away).
      if (game.startTime > 0) {
        game.duration = (game.deathTime - game.startTime) / 1000;
      }
    }

    // ===== Read real DOM hero positions for seamless handoff =====
    type HeroSpan = { x: number; baseline: number; w: number; h: number };
    type HeroMeasure = {
      spans: HeroSpan[];
      fontSize: number;
      texts: string[];
      letterSpacing: string;
      fontFamily: string;
      fontWeight: string;
    };

    // Probe each span's true alphabetic baseline by inserting a zero-size inline-block
    // helper with vertical-align: baseline — its top edge sits exactly on the baseline.
    function probeBaseline(span: HTMLElement): number {
      const probe = document.createElement('span');
      probe.style.cssText = 'display:inline-block;width:0;height:0;vertical-align:baseline;';
      span.appendChild(probe);
      const baseline = probe.getBoundingClientRect().top;
      span.removeChild(probe);
      return baseline;
    }

    function measureHero(): HeroMeasure | null {
      const spans = document.querySelectorAll<HTMLElement>('.hero h1 .scramble-text');
      if (spans.length < 2) return null;
      const style = window.getComputedStyle(spans[0]);
      const fs = parseFloat(style.fontSize);
      const measures: HeroSpan[] = Array.from(spans).map(s => {
        const rect = s.getBoundingClientRect();
        return { x: rect.left, baseline: probeBaseline(s), w: rect.width, h: rect.height };
      });
      const texts = Array.from(spans).map(s => s.dataset.text || s.textContent || '');
      return {
        spans: measures,
        fontSize: fs,
        texts: texts.map(t => t.toUpperCase()),
        letterSpacing: style.letterSpacing && style.letterSpacing !== 'normal' ? style.letterSpacing : '0px',
        fontFamily: style.fontFamily,
        fontWeight: style.fontWeight,
      };
    }

    function drawHeroBlock(textColor: string, alpha: number) {
      if (alpha <= 0.001) return;
      const hero = measureHero();
      if (!hero) return;
      ctx!.save();
      ctx!.globalAlpha = alpha;
      ctx!.font = `${hero.fontWeight} ${hero.fontSize}px ${hero.fontFamily}`;
      // Match CSS letter-spacing (and font-kerning) so character advances line up.
      // letterSpacing is widely supported (Chrome 99+, Safari 16.4+, FF 114+).
      (ctx as any).letterSpacing = hero.letterSpacing;
      (ctx as any).fontKerning = 'normal';
      ctx!.textBaseline = 'alphabetic';
      ctx!.textAlign = 'left';
      ctx!.fillStyle = textColor;
      hero.spans.forEach((m, i) => {
        ctx!.fillText(hero.texts[i] || '', m.x, m.baseline);
      });
      ctx!.restore();
    }

    // ===== Color lerp =====
    function hexToRgb(h: string): [number, number, number] {
      h = h.replace('#','');
      return [parseInt(h.substr(0,2),16), parseInt(h.substr(2,2),16), parseInt(h.substr(4,2),16)];
    }
    function lerpColor(a: string, b: string, t: number) {
      const A = hexToRgb(a), B = hexToRgb(b);
      return `rgb(${Math.round(A[0]+(B[0]-A[0])*t)}, ${Math.round(A[1]+(B[1]-A[1])*t)}, ${Math.round(A[2]+(B[2]-A[2])*t)})`;
    }

    function drawDot(x: number, y: number, r: number, glow = true) {
      if (glow) { ctx!.shadowColor = C.greenGlow; ctx!.shadowBlur = 14; }
      ctx!.fillStyle = C.green;
      ctx!.beginPath();
      ctx!.arc(x, y, r, 0, Math.PI * 2);
      ctx!.fill();
      if (glow) ctx!.shadowBlur = 0;
    }

    function update(_dt: number, now: number) {
      if (game.state === 'playing') {
        game.bird.vy += PHYS.gravity * _dt;
        game.bird.y  += game.bird.vy * _dt;
        game.worldOffset += currentScroll() * _dt;

        if (game.bird.y < 10) { game.bird.y = 10; game.bird.vy = 0; }
        if (game.bird.y > H - 10) { game.bird.y = H - 10; die(); return; }

        const last = game.obstacles[game.obstacles.length - 1];
        if (last && (last.worldX - game.worldOffset) < W + PHYS.spacing * 2) {
          game.obstacles.push(makeObstacle(last.worldX + PHYS.spacing));
        }
        while (game.obstacles.length && game.obstacles[0].worldX - game.worldOffset < -20) {
          game.obstacles.shift();
        }

        const bwx = birdWorldX();
        for (const o of game.obstacles) {
          if (!o.passed && o.worldX < bwx - 4) { o.passed = true; game.score++; }
        }
        for (const o of game.obstacles) {
          const dx = Math.abs(o.worldX - bwx);
          if (dx < PHYS.birdR + 2) {
            if (game.bird.y - PHYS.birdR < o.gapY ||
                game.bird.y + PHYS.birdR > o.gapY + o.gapSize) {
              die(); return;
            }
          }
        }
      }

      if (game.state === 'dying') {
        const t = now - game.deathTime;
        if (t >= PH.done.s && !game.handoffStarted) {
          game.handoffStarted = true;
          handoff();
        }
      }
    }

    function handoff() {
      // 1. Force any in-progress scramble-text to final state
      document.querySelectorAll<HTMLElement>('.scramble-text').forEach(el => {
        const target = el.dataset.text || el.textContent || '';
        el.textContent = target;
      });
      // 2. Force .hero .reveal items to visible state (so they don't fade in after handoff)
      document.querySelectorAll('.hero .reveal, .hero.reveal').forEach(el => el.classList.add('vis'));

      // 3. Prepare ambient layers for an explicit, transition-guaranteed fade-in.
      //    Inline styles sidestep the CSS specificity issues that were causing the pop.
      const hud = document.querySelector('.hud') as HTMLElement | null;
      const particles = document.getElementById('particles') as HTMLElement | null;
      const spotlight = document.getElementById('spotlight') as HTMLElement | null;
      const ambient: HTMLElement[] = [hud, particles, spotlight].filter(Boolean) as HTMLElement[];
      ambient.forEach(el => {
        el.style.opacity = '0';
        el.style.transition = 'opacity 900ms ease';
      });

      // 5. Begin overlay fadeout (longer, so the overlay-revealed layers blend in)
      overlay!.style.transition = 'opacity 700ms ease';
      overlay!.classList.add('dismiss');

      // 6. Once the overlay has started fading, lift the active class and trigger ambient opacity → 1
      setTimeout(() => {
        html.classList.remove('hero-game-active');
        // Two RAFs so the browser commits the opacity:0 state before transitioning to 1
        requestAnimationFrame(() => requestAnimationFrame(() => {
          ambient.forEach(el => { el.style.opacity = '1'; });
        }));
      }, 200);

      // 7. After the fade completes, remove overlay and clean up inline styles
      setTimeout(() => {
        overlay!.remove();
        game.state = 'done';
        ambient.forEach(el => {
          el.style.transition = '';
          el.style.opacity = '';
        });
        // Surface the reward: open the wall in claim mode (or nudge if sub-tier).
        const seconds = game.duration;
        document.dispatchEvent(new CustomEvent('wall:claim', {
          detail: { seconds, tier: tierFor(seconds) },
        }));
      }, 1500);
    }

    function render() {
      const now = performance.now();
      const deathT = game.state === 'dying' ? (now - game.deathTime) : 0;

      ctx!.fillStyle = C.bg;
      ctx!.fillRect(0, 0, W, H);

      const showWorld =
        game.state === 'idle' ||
        game.state === 'playing' ||
        (game.state === 'dying' && deathT < PH.greenHold.s);

      if (showWorld) {
        // Boundaries
        ctx!.strokeStyle = C.boundary;
        ctx!.lineWidth = PHYS.boundaryStroke;
        ctx!.beginPath();
        ctx!.moveTo(-W * 5, 10);  ctx!.lineTo(W * 5, 10);
        ctx!.moveTo(-W * 5, H-10); ctx!.lineTo(W * 5, H-10);
        ctx!.stroke();

        // Obstacles
        ctx!.strokeStyle = C.obstacle;
        ctx!.lineWidth = PHYS.obstacleStroke;
        for (const o of game.obstacles) {
          const sx = o.worldX - game.worldOffset;
          ctx!.beginPath();
          ctx!.moveTo(sx, 10);
          ctx!.lineTo(sx, o.gapY);
          ctx!.moveTo(sx, o.gapY + o.gapSize);
          ctx!.lineTo(sx, H - 10);
          ctx!.stroke();
        }

        const birdVisible =
          game.state === 'idle' ||
          game.state === 'playing' ||
          (game.state === 'dying' && deathT < PH.expand.s);
        if (birdVisible) drawDot(birdScreenX(), game.bird.y, PHYS.birdR);
      }

      // Expanding green disk
      if (game.state === 'dying' && deathT >= PH.expand.s && deathT < PH.greenHold.s) {
        const t = easeInOut(phaseT('expand', deathT));
        const corners = [
          Math.hypot(game.deathX, game.deathY),
          Math.hypot(W - game.deathX, game.deathY),
          Math.hypot(game.deathX, H - game.deathY),
          Math.hypot(W - game.deathX, H - game.deathY),
        ];
        const maxR = Math.max(...corners) * 1.05;
        const r = PHYS.birdR + (maxR - PHYS.birdR) * t;
        ctx!.shadowColor = C.greenGlow;
        ctx!.shadowBlur = 24;
        ctx!.fillStyle = C.green;
        ctx!.beginPath();
        ctx!.arc(game.deathX, game.deathY, r, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.shadowBlur = 0;
      }

      // Solid color phase + hero text reveal + wipe
      if (game.state === 'dying' && deathT >= PH.greenHold.s) {
        const wT = phaseT('wipe', deathT);
        const wipeEase = easeInOut(wT);
        const bg = wT > 0 ? lerpColor(C.green, C.bg, wipeEase) : C.green;
        ctx!.fillStyle = bg;
        ctx!.fillRect(0, 0, W, H);

        const tInEase = easeOut(phaseT('textIn', deathT));
        const textColor = wT > 0 ? lerpColor(C.bg, C.text, wipeEase) : C.bg;
        drawHeroBlock(textColor, tInEase);
      }

      // Score (corner) during play
      if (game.state === 'idle' || game.state === 'playing' ||
          (game.state === 'dying' && deathT < PH.expand.s)) {
        ctx!.fillStyle = C.textMid;
        ctx!.font = '12px JetBrains Mono, ui-monospace, monospace';
        ctx!.textAlign = 'right';
        ctx!.textBaseline = 'top';
        ctx!.fillText(String(game.score).padStart(3, '0'), W - 28, 24);
      }

      if (game.state === 'idle') {
        ctx!.fillStyle = C.textDim;
        ctx!.font = '11px JetBrains Mono, ui-monospace, monospace';
        ctx!.textAlign = 'center';
        ctx!.textBaseline = 'alphabetic';
        ctx!.fillText('tap or press space', W / 2, H - 36);
      }
    }

    let lastTime = performance.now();
    function tick(now: number) {
      if (game.state === 'done') return; // stop the loop once handed off
      const dt = Math.min((now - lastTime) / 1000, 1 / 30);
      lastTime = now;
      update(dt, now);
      render();
      requestAnimationFrame(tick);
    }

    canvas.addEventListener('pointerdown', (e) => { e.preventDefault(); onTap(); });
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && (game.state === 'idle' || game.state === 'playing')) {
        e.preventDefault(); onTap();
      }
    });
    window.addEventListener('resize', () => {
      const prev = game.state;
      resize();
      if (prev === 'idle') reset();
    });

    // Preload Bayon so the hero reveal isn't unstyled
    if ((document as any).fonts && (document as any).fonts.load) {
      (document as any).fonts.load('400 100px Bayon').catch(() => {});
    }

    // Pre-reveal hero elements so DOM measurements reflect the *final* position
    // (without .reveal's translateY(32px) offset). Invisible behind the canvas overlay.
    function preRevealHero() {
      document.querySelectorAll('.hero .reveal, .hero.reveal').forEach(el => el.classList.add('vis'));
    }
    preRevealHero();
    // Re-apply after fonts load in case the layout shifted (final font metrics)
    if ((document as any).fonts && (document as any).fonts.ready) {
      (document as any).fonts.ready.then(preRevealHero).catch(() => {});
    }

    // ===== First-visit gating =====
    // The intro game plays once. Returning visitors land straight on the site;
    // "Play Now" on the wall sets hg_replay and reloads to play again.
    function skipIntro() {
      html.classList.remove('hero-game-active');
      document.querySelectorAll('.hero .reveal, .hero.reveal').forEach(el => el.classList.add('vis'));
      if (overlay) overlay.remove();
      game.state = 'done';
    }
    let forceReplay = false;
    try {
      forceReplay = sessionStorage.getItem('hg_replay') === '1';
      if (forceReplay) sessionStorage.removeItem('hg_replay');
    } catch {}
    let seen = false;
    try { seen = localStorage.getItem('hg_seen') === '1'; } catch {}
    if (seen && !forceReplay) { skipIntro(); return; }
    try { localStorage.setItem('hg_seen', '1'); } catch {}

    resize();
    reset();
    requestAnimationFrame(tick);
  })();
</script>
